@model IncidenciasViewModel
@{
    ViewData["Title"] = "Incidencias";
}

<h1 class="h3 mb-3">Incidencias abiertas en tiempo real</h1>

@if (TempData["ErrorBusqueda"] is string errorBusqueda)
{
    <div class="alert alert-warning" role="alert">@errorBusqueda</div>
}

<form asp-controller="Operaciones" asp-action="Incidencias" method="get" class="panel-busqueda">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md">
            <input type="text" name="query" value="@Model.Query" class="form-control input-busqueda"
                   placeholder="Buscar por estacion o descripcion" aria-label="Buscar incidencias" />
        </div>
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-primary w-100">Buscar</button>
        </div>
        @if (Model.ConBusqueda)
        {
            <div class="col-12 col-md-auto">
                <a asp-controller="Operaciones" asp-action="Incidencias" class="btn btn-outline-secondary w-100">Limpiar busqueda</a>
            </div>
        }
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="tarjeta-estado abierta">
            <div class="titulo">Abiertas</div>
            <div class="valor">@Model.Incidencias.Count</div>
            <div class="detalle">Pendientes de cierre</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="tarjeta-estado busqueda">
            <div class="titulo">Resultado</div>
            <div class="valor">@(Model.ConBusqueda ? "Busqueda" : "Listado")</div>
            <div class="detalle">
                @if (Model.ConBusqueda)
                {
                    <span>@Model.Incidencias.Count para &laquo;@Model.Query&raquo;</span>
                }
                else
                {
                    <span>Servido desde Redis</span>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="tarjeta-estado tiempo-real d-flex flex-column justify-content-center">
            <div class="titulo">Canal en tiempo real</div>
            <div class="mt-2">
                <span id="avisoConexion" class="canal-estado desconectado">Iniciando...</span>
            </div>
            <div class="detalle">Los cierres de otros Supervisors llegan por WebSocket</div>
        </div>
    </div>
</div>

<div class="table-responsive tabla-incidencias">
    <table class="table table-striped align-middle mb-0" id="tablaIncidencias">
        <thead>
            <tr>
                <th scope="col">Estacion</th>
                <th scope="col">Descripcion</th>
                <th scope="col">Prioridad</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end">Accion</th>
            </tr>
        </thead>
        <tbody id="cuerpoIncidencias">
            @foreach (var incidencia in Model.Incidencias)
            {
                <tr id="incidencia-@incidencia.Id" data-incidencia-id="@incidencia.Id">
                    <td class="estacion-tag">@incidencia.Estacion</td>
                    <td class="descripcion-incidencia">@incidencia.Descripcion</td>
                    <td>
                        @switch (incidencia.Prioridad)
                        {
                            case Prioridad.Alta:
                                <span class="badge text-bg-danger">@incidencia.Prioridad</span>
                                break;
                            case Prioridad.Media:
                                <span class="badge text-bg-warning">@incidencia.Prioridad</span>
                                break;
                            default:
                                <span class="badge text-bg-secondary">@incidencia.Prioridad</span>
                                break;
                        }
                    </td>
                    <td data-campo="estado">
                        <span class="badge text-bg-primary">@incidencia.Estado</span>
                    </td>
                    <td class="text-end">
                        <form asp-controller="Operaciones" asp-action="Cerrar" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@incidencia.Id" />
                            <input type="hidden" name="query" value="@Model.Query" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* La configuracion viaja como JSON y no como codigo: el navegador la lee con
   JSON.parse, de modo que la API Key nunca se concatena dentro de una cadena JS.
   El serializador escapa <, > y &, asi que es seguro escribirlo en la vista. *@
<script id="pieHostConfig" type="application/json">@Html.Raw(Model.ConfigJson)</script>

<script>
    (function () {
        'use strict';

        var nodoConfig = document.getElementById('pieHostConfig');
        if (!nodoConfig) { return; }

        var cfg = JSON.parse(nodoConfig.textContent);
        var cuerpo = document.getElementById('cuerpoIncidencias');
        var aviso = document.getElementById('avisoConexion');
        var socket = null;
        var intento = 0;

        function marcarConexion(texto, estado) {
            if (!aviso) { return; }
            aviso.textContent = texto;
            aviso.className = 'canal-estado ' + estado;
        }

        if (!cfg.urlSuscripcion) {
            marcarConexion('PieHost sin configurar', 'sin-configurar');
            return;
        }

        function filas() {
            if (!cuerpo) { return []; }
            return Array.prototype.slice.call(cuerpo.querySelectorAll('tr[data-incidencia-id]'));
        }

        // Cambia el estado de la fila en la tabla, sin recargar la pagina.
        function aplicarEstado(id, estado) {
            var fila = document.getElementById('incidencia-' + id);
            if (!fila) { return false; }

            var cerrada = estado === 'Cerrada';
            var celda = fila.querySelector('[data-campo="estado"]');
            if (celda) {
                celda.innerHTML = cerrada
                    ? '<span class="badge text-bg-success">Cerrada</span>'
                    : '<span class="badge text-bg-primary">Abierta</span>';
            }
            fila.classList.toggle('fila-cerrada', cerrada);

            var boton = fila.querySelector('button[type="submit"]');
            if (boton && cerrada) {
                boton.disabled = true;
                boton.textContent = 'Cerrada';
                boton.classList.remove('btn-outline-danger');
                boton.classList.add('btn-outline-secondary');
            }
            return true;
        }

        // Consulta el estado vigente al servidor: cubre los eventos perdidos
        // mientras el navegador estuvo desconectado.
        function sincronizarEstadoVigente() {
            if (!cfg.estadoUrl) { return Promise.resolve(); }

            return fetch(cfg.estadoUrl, {
                headers: { 'Accept': 'application/json' },
                credentials: 'same-origin'
            })
                .then(function (r) {
                    if (!r.ok) { throw new Error('HTTP ' + r.status); }
                    return r.json();
                })
                .then(function (abiertas) {
                    var idsAbiertas = new Set(abiertas.map(function (i) { return i.Id; }));
                    filas().forEach(function (fila) {
                        var id = Number(fila.dataset.incidenciaId);
                        aplicarEstado(id, idsAbiertas.has(id) ? 'Abierta' : 'Cerrada');
                    });
                })
                .catch(function (e) {
                    console.warn('No se pudo sincronizar el estado vigente.', e);
                });
        }

        function programarReintento() {
            var anterior = socket;
            socket = null;
            if (anterior) {
                try {
                    anterior.onclose = null;
                    anterior.close();
                } catch (e) { /* ya estaba cerrado */ }
            }
            intento += 1;
            var espera = Math.min(1000 * Math.pow(2, intento - 1), 15000);
            marcarConexion('Reconectando...', 'reconectando');
            setTimeout(conectar, espera);
        }

        function conectar() {
            marcarConexion('Conectando...', 'conectando');

            var url = cfg.urlSuscripcion;

            try {
                socket = new WebSocket(url);
            } catch (e) {
                console.error('No se pudo abrir el WebSocket.', e);
                programarReintento();
                return;
            }

            socket.onopen = function () {
                intento = 0;
                marcarConexion('Conectado', 'conectado');
                sincronizarEstadoVigente();
            };

            socket.onmessage = function (mensaje) {
                var sobre;
                try {
                    sobre = JSON.parse(mensaje.data);
                } catch (e) {
                    return;
                }

                if (sobre.event === 'system:error') {
                    marcarConexion('Error de canal', 'error');
                    console.error('PieHost:', sobre.data);
                    return;
                }
                if (sobre.event === 'system:closed') {
                    marcarConexion('Desconectado', 'desconectado');
                    programarReintento();
                    return;
                }
                if (sobre.event === 'system:connected') {
                    marcarConexion('Conectado', 'conectado');
                    return;
                }

                if (sobre.event !== 'IncidenciaActualizada') { return; }

                var datos = sobre.data;
                if (!datos || datos.Id === undefined || datos.Id === null) { return; }

                aplicarEstado(Number(datos.Id), datos.Estado);
                console.log('IncidenciaActualizada:', datos);
            };

            socket.onclose = function () {
                marcarConexion('Reconectando...', 'reconectando');
                programarReintento();
            };

            socket.onerror = function () {
                if (socket) { socket.close(); }
            };
        }

        conectar();
    })();
</script>
